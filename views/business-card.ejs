<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>כרטיס ביקור — <%= installer.name %></title>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:'Heebo',sans-serif;
  background:#1a1a2e;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:100vh;gap:32px;padding:40px 20px;
}

/* ── Controls (hidden on print) ── */
.controls{
  display:flex;gap:12px;align-items:center;flex-wrap:wrap;justify-content:center;
}
.btn{
  padding:12px 28px;border-radius:8px;border:none;cursor:pointer;
  font-family:'Heebo',sans-serif;font-size:0.9rem;font-weight:700;
  transition:all .2s;
}
.btn-print{background:#C9963A;color:#fff}
.btn-print:hover{background:#E8B04B}
.btn-style{background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.2)}
.btn-style:hover{background:rgba(255,255,255,0.15)}
.btn-back{background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.6);font-size:0.82rem}

.style-label{color:rgba(255,255,255,0.5);font-size:0.82rem}

/* ── Card Wrapper ── */
.card-wrap{
  display:flex;flex-direction:column;gap:0;
  filter:drop-shadow(0 20px 60px rgba(0,0,0,0.5));
}

/* ── CARD: Dark Gold (style 1) ── */
.card{
  width:338px;height:190px;
  border-radius:12px;
  overflow:hidden;
  position:relative;
  font-family:'Heebo',sans-serif;
}

/* FRONT */
.card-front.dark-gold{
  background:#0D0D0D;
  display:flex;flex-direction:column;justify-content:center;
  padding:28px 28px;
  border-bottom:0;
}
.dark-gold .top-line{
  position:absolute;top:0;right:0;left:0;height:3px;
  background:linear-gradient(90deg,transparent,#C9963A,#E8B04B,transparent);
}
.dark-gold .logo-area{
  margin-bottom:14px;
}
.dark-gold .logo-area img{
  height:28px;object-fit:contain;
}
.dark-gold .logo-text{
  font-size:1.1rem;font-weight:900;color:#C9963A;letter-spacing:1px;
}
.dark-gold .name{
  font-size:1.2rem;font-weight:800;color:#fff;margin-bottom:3px;
}
.dark-gold .title{
  font-size:0.72rem;color:#C9963A;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;
  margin-bottom:14px;
}
.dark-gold .contacts{
  display:flex;flex-direction:column;gap:3px;
}
.dark-gold .contact-item{
  font-size:0.72rem;color:rgba(255,255,255,0.6);
  display:flex;align-items:center;gap:6px;
}
.dark-gold .contact-icon{color:#C9963A;font-size:0.75rem;width:12px;text-align:center}
.dark-gold .deco{
  position:absolute;bottom:-30px;left:-30px;
  width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle,rgba(201,150,58,0.08),transparent);
}

/* BACK */
.card-back.dark-gold{
  background:linear-gradient(135deg,#0D0D0D 60%,#1a1200);
  display:flex;align-items:center;justify-content:center;
  border-top:1px solid rgba(201,150,58,0.15);
}
.dark-gold-back-logo{
  font-size:2rem;font-weight:900;color:#C9963A;letter-spacing:3px;opacity:0.3;
}
.dark-gold .back-line{
  position:absolute;bottom:0;right:0;left:0;height:2px;
  background:linear-gradient(90deg,transparent,#C9963A,transparent);
}

/* ── CARD: Red White (style 2) ── */
.card-front.red-white{
  background:#fff;
  padding:0;overflow:hidden;
}
.red-white .red-panel{
  position:absolute;top:0;right:0;width:45%;height:100%;
  background:linear-gradient(145deg,#8B0000,#C41230);
  clip-path:polygon(20% 0,100% 0,100% 100%,0% 100%);
}
.red-white .content{
  position:relative;z-index:1;padding:24px 24px;
  display:flex;flex-direction:column;justify-content:center;height:100%;
}
.red-white .logo-area img{ height:24px;object-fit:contain;margin-bottom:10px; }
.red-white .logo-text{ font-size:1rem;font-weight:900;color:#8B0000;margin-bottom:10px; }
.red-white .name{ font-size:1.1rem;font-weight:800;color:#1a0000;margin-bottom:2px; }
.red-white .title{ font-size:0.68rem;color:#8B0000;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px; }
.red-white .contact-item{ font-size:0.7rem;color:#444;display:flex;align-items:center;gap:5px;margin-bottom:3px; }
.red-white .contact-icon{ color:#8B0000;width:12px;text-align:center; }
.red-white .white-dots{
  position:absolute;top:0;right:0;width:45%;height:100%;
  display:flex;align-items:center;justify-content:center;
  pointer-events:none;
}
.red-white .initials{
  font-size:3.5rem;font-weight:900;color:rgba(255,255,255,0.15);letter-spacing:-2px;
  position:absolute;top:50%;right:5%;transform:translateY(-50%);
}

.card-back.red-white{
  background:linear-gradient(135deg,#8B0000,#C41230);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:8px;
}
.red-white-back-logo{ font-size:1.8rem;font-weight:900;color:rgba(255,255,255,0.15);letter-spacing:3px; }
.card-back.red-white .qr-hint{ font-size:0.65rem;color:rgba(255,255,255,0.3);letter-spacing:1px; }

/* ── Separator ── */
.card-sep{
  height:0;border-top:1px dashed rgba(255,255,255,0.1);
  width:338px;margin:0;
}

/* ── SIZE LABEL ── */
.size-note{
  color:rgba(255,255,255,0.3);font-size:0.72rem;text-align:center;
}

/* ── PRINT ── */
@media print{
  body{background:#fff;padding:0;min-height:auto;gap:0}
  .controls,.size-note{display:none!important}
  .card-wrap{filter:none;gap:0}
  .card-sep{display:none}

  @page{
    size:85.6mm 53.98mm;
    margin:0;
  }
  .card{
    width:85.6mm;height:53.98mm;
    border-radius:0;
    page-break-after:always;
  }
  .card-back{ page-break-before:always; }
}
</style>
</head>
<body>

<div class="controls">
  <a href="/admin" class="btn btn-back">← חזור לאדמין</a>
  <span class="style-label">סגנון:</span>
  <button class="btn btn-style" onclick="setStyle('dark')">⬛ כהה זהב</button>
  <button class="btn btn-style" onclick="setStyle('red')">🔴 אדום לבן</button>
  <button class="btn btn-print" onclick="window.print()">🖨️ הדפס / שמור PDF</button>
</div>

<div class="size-note">גודל סטנדרטי: 85.6 × 54 מ"מ | הדפסה → שמור כ-PDF</div>

<!-- ── DARK GOLD ── -->
<div class="card-wrap" id="wrap-dark">

  <div class="card card-front dark-gold">
    <div class="top-line"></div>
    <div class="deco"></div>
    <div class="logo-area">
      <% if(installer.logo && installer.logo.url){ %>
        <img src="<%= installer.logo.url %>" alt="לוגו"/>
      <% } else { %>
        <div class="logo-text"><%= (installer.businessName || installer.name).toUpperCase() %></div>
      <% } %>
    </div>
    <div class="name"><%= installer.name %></div>
    <div class="title"><%= installer.tagline || 'מומחה אינטרקום ובקרת כניסה' %></div>
    <div class="contacts">
      <% if(installer.phone){ %>
      <div class="contact-item"><span class="contact-icon">📞</span><%= installer.phone %></div>
      <% } %>
      <% if(installer.whatsapp){ %>
      <div class="contact-item"><span class="contact-icon">💬</span><%= installer.whatsapp %></div>
      <% } %>
      <% if(installer.areas && installer.areas.length){ %>
      <div class="contact-item"><span class="contact-icon">📍</span><%= installer.areas.slice(0,3).join(' | ') %></div>
      <% } %>
      <div class="contact-item"><span class="contact-icon">🌐</span>installers.co.il/<%= installer.slug %></div>
    </div>
  </div>

  <div class="card-sep"></div>

  <div class="card card-back dark-gold" style="position:relative">
    <% if(installer.logo && installer.logo.url){ %>
      <img src="<%= installer.logo.url %>" style="height:40px;object-fit:contain;opacity:0.25"/>
    <% } else { %>
      <div class="dark-gold-back-logo"><%= (installer.businessName || installer.name).substring(0,6).toUpperCase() %></div>
    <% } %>
    <div class="back-line"></div>
  </div>

</div>

<!-- ── RED WHITE ── -->
<div class="card-wrap" id="wrap-red" style="display:none">

  <div class="card card-front red-white">
    <div class="red-panel"></div>
    <div class="initials"><%= installer.name.charAt(0) %></div>
    <div class="content">
      <% if(installer.logo && installer.logo.url){ %>
        <img src="<%= installer.logo.url %>" class="logo-area" style="height:24px;object-fit:contain;margin-bottom:10px"/>
      <% } else { %>
        <div class="logo-text"><%= (installer.businessName || installer.name).toUpperCase() %></div>
      <% } %>
      <div class="name"><%= installer.name %></div>
      <div class="title"><%= installer.tagline || 'מומחה אינטרקום ובקרת כניסה' %></div>
      <% if(installer.phone){ %><div class="contact-item"><span class="contact-icon">📞</span><%= installer.phone %></div><% } %>
      <% if(installer.whatsapp){ %><div class="contact-item"><span class="contact-icon">💬</span><%= installer.whatsapp %></div><% } %>
      <% if(installer.areas && installer.areas.length){ %><div class="contact-item"><span class="contact-icon">📍</span><%= installer.areas.slice(0,2).join(' | ') %></div><% } %>
      <div class="contact-item"><span class="contact-icon">🌐</span>installers.co.il/<%= installer.slug %></div>
    </div>
  </div>

  <div class="card-sep"></div>

  <div class="card card-back red-white">
    <% if(installer.logo && installer.logo.url){ %>
      <img src="<%= installer.logo.url %>" style="height:36px;object-fit:contain;opacity:0.2"/>
    <% } else { %>
      <div class="red-white-back-logo"><%= (installer.businessName || installer.name).toUpperCase().substring(0,8) %></div>
    <% } %>
    <div class="qr-hint">installers.co.il/<%= installer.slug %></div>
  </div>

</div>

<script>
function setStyle(s){
  document.getElementById('wrap-dark').style.display = s==='dark' ? 'flex' : 'none';
  document.getElementById('wrap-red').style.display  = s==='red'  ? 'flex' : 'none';
}
</script>
</body>
</html>
