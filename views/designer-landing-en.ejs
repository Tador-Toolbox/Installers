<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= designer.name %> | Interior Design</title>
  <meta name="description" content="<%= designer.tagline || 'Award-winning interior designer – contact us for a free consultation' %>" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600;700;900&display=swap" rel="stylesheet" />

  <style>
    /* ── Reset & Base ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:        #080806;
      --surface:   #101010;
      --surface2:  #181816;
      --surface3:  #202020;
      --accent:    #a8a29a;
      --accent2:   #ccc6be;
      --text:      #dedad5;
      --text-dim:  #4e4c4a;
      --border:    rgba(168,162,154,0.10);
      --border2:   rgba(168,162,154,0.26);
      --r:         2px;
      --r-sm:      1px;
      --shadow:    0 28px 90px rgba(0,0,0,0.92);
      --nav-h:     68px;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
      letter-spacing: 0.012em;
    }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }

    /* ── Scrollbar ────────────────────────────────────────────── */
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--accent); }

    /* ── Utility ──────────────────────────────────────────────── */
    .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
    .fade-up { opacity: 0; transform: translateY(28px); transition: opacity .6s ease, transform .6s ease; }
    .fade-up.visible { opacity: 1; transform: translateY(0); }

    /* ── NAV ──────────────────────────────────────────────────── */
    #nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 900;
      height: var(--nav-h);
      display: flex; align-items: center;
      padding: 0 24px;
      transition: background .35s, backdrop-filter .35s, box-shadow .35s;
    }
    #nav.scrolled {
      background: rgba(8,8,6,0.97);
      backdrop-filter: blur(20px);
      box-shadow: 0 1px 0 rgba(168,162,154,0.08);
    }
    .nav-inner {
      width: 100%; max-width: 1100px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
    }
    .nav-logo { display: flex; align-items: center; gap: 10px; }
    .nav-logo img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
    .nav-name { font-size: 1rem; font-weight: 700; }
    .nav-links { display: flex; gap: 28px; }
    .nav-links a {
      font-size: .85rem; font-weight: 500; color: var(--text-dim);
      transition: color .2s; letter-spacing: 0.04em;
    }
    .nav-links a:hover { color: var(--accent); }
    .nav-cta {
      background: var(--accent); color: #080806;
      padding: 9px 22px; border-radius: 0;
      font-size: .85rem; font-weight: 600;
      letter-spacing: 0.05em;
      transition: opacity .2s;
    }
    .nav-cta:hover { opacity: .85; }
    @media(max-width:640px) { .nav-links { display: none; } }

    /* ── HERO ─────────────────────────────────────────────────── */
    #hero {
      position: relative;
      min-height: 100svh;
      display: flex; align-items: flex-end;
      padding-bottom: 80px;
    }
    .hero-bg { position: absolute; inset: 0; background: var(--bg); }
    .hero-bg img { width: 100%; height: 100%; object-fit: cover; opacity: .45; }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(
        to top,
        rgba(8,8,6,0.97) 0%,
        rgba(8,8,6,0.60) 40%,
        rgba(8,8,6,0.08) 100%
      );
    }
    .hero-content {
      position: relative; z-index: 2;
      max-width: 680px;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: transparent;
      border: 1px solid var(--border2);
      padding: 6px 14px; border-radius: 0;
      font-size: .66rem; font-weight: 500; letter-spacing: .22em;
      color: var(--accent); text-transform: uppercase;
      margin-bottom: 20px;
    }
    h1.hero-name {
      font-size: clamp(3rem, 10vw, 7rem);
      font-weight: 200; line-height: 0.96;
      letter-spacing: -0.04em;
      margin-bottom: 12px;
    }
    .hero-tagline {
      font-size: clamp(0.9rem, 2.5vw, 1.15rem);
      color: var(--text-dim); font-weight: 300;
      letter-spacing: 0.03em;
      margin-bottom: 36px; max-width: 520px;
    }
    .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }
    .btn-primary {
      background: var(--accent); color: #080806;
      padding: 14px 32px; border-radius: 0;
      font-size: 0.88rem; font-weight: 600; letter-spacing: 0.06em;
      transition: background .2s, transform .2s, box-shadow .2s;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-primary:hover { background: var(--accent2); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(168,162,154,0.22); }
    .btn-secondary {
      border: 1px solid rgba(168,162,154,0.28);
      color: var(--accent); padding: 14px 32px; border-radius: 0;
      font-size: 0.88rem; font-weight: 600; letter-spacing: 0.06em;
      background: transparent;
      transition: border-color .2s, background .2s;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-secondary:hover { border-color: var(--accent); background: rgba(168,162,154,0.06); }

    /* ── STATS BAR ────────────────────────────────────────────── */
    #stats {
      background: transparent;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 36px 20px;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .stat-item {
      text-align: center;
      padding: 0 20px;
      border-right: 1px solid rgba(168,162,154,0.09);
    }
    .stat-item:last-child { border-right: none; }
    .stat-num {
      font-size: clamp(2.2rem, 5vw, 3.2rem);
      font-weight: 200; color: var(--accent);
      line-height: 1; letter-spacing: -0.05em;
    }
    .stat-label {
      font-size: .68rem; color: var(--text-dim); margin-top: 6px;
      font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
    }
    @media(max-width:600px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); row-gap: 28px; }
      .stat-item:nth-child(2n) { border-right: 1px solid rgba(168,162,154,0.09); }
      .stat-item:nth-child(2n+1) { border-right: none; }
    }

    /* ── SECTION HEADER ───────────────────────────────────────── */
    .section-header { text-align: center; margin-bottom: 52px; }
    .section-eyebrow {
      font-size: .65rem; font-weight: 500; letter-spacing: .28em;
      color: var(--text-dim); text-transform: uppercase;
      margin-bottom: 10px;
    }
    .section-title {
      font-size: clamp(1.6rem, 4vw, 2.6rem);
      font-weight: 300; line-height: 1.15; letter-spacing: -0.025em;
    }
    .section-sub {
      color: var(--text-dim); margin-top: 12px;
      font-size: 1rem; font-weight: 300;
    }

    /* ── PORTFOLIO ────────────────────────────────────────────── */
    #portfolio { padding: 100px 0; }
    .masonry { columns: 3; column-gap: 14px; }
    .masonry-item {
      break-inside: avoid; margin-bottom: 14px;
      border-radius: 0; overflow: hidden;
      cursor: zoom-in; position: relative;
    }
    .masonry-item img { width: 100%; display: block; transition: transform .5s ease; }
    .masonry-item:hover img { transform: scale(1.04); }
    .masonry-overlay {
      position: absolute; inset: 0;
      background: rgba(8,8,6,0);
      display: flex; align-items: center; justify-content: center;
      transition: background .3s;
    }
    .masonry-item:hover .masonry-overlay { background: rgba(8,8,6,0.35); }
    .masonry-zoom { opacity: 0; font-size: 1.6rem; transition: opacity .3s; }
    .masonry-item:hover .masonry-zoom { opacity: 1; }
    @media(max-width:700px) { .masonry { columns: 2; column-gap: 10px; } .masonry-item { margin-bottom: 10px; } }
    @media(max-width:440px) { .masonry { columns: 1; } }

    /* Lightbox */
    #lightbox {
      display: none; position: fixed; inset: 0; z-index: 9000;
      background: rgba(0,0,0,.94);
      align-items: center; justify-content: center;
    }
    #lightbox.open { display: flex; }
    #lightbox img { max-width: 92vw; max-height: 90vh; border-radius: 0; object-fit: contain; }
    #lb-close {
      position: fixed; top: 20px; right: 20px;
      background: rgba(255,255,255,.1); border: none;
      color: #fff; font-size: 1.6rem; cursor: pointer;
      width: 48px; height: 48px; border-radius: 0;
      display: flex; align-items: center; justify-content: center;
      transition: background .2s;
    }
    #lb-close:hover { background: rgba(255,255,255,.2); }
    #lb-prev, #lb-next {
      position: fixed; top: 50%; transform: translateY(-50%);
      background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
      color: #fff; font-size: 1.4rem; cursor: pointer;
      width: 52px; height: 52px; border-radius: 0;
      display: flex; align-items: center; justify-content: center;
      transition: background .2s;
    }
    #lb-prev:hover, #lb-next:hover { background: rgba(255,255,255,.18); }
    #lb-prev { left: 20px; } #lb-next { right: 20px; }

    /* ── ABOUT ────────────────────────────────────────────────── */
    #about { padding: 100px 0; }
    .about-grid {
      display: grid; grid-template-columns: 2fr 3fr;
      gap: 64px; align-items: start;
    }
    .about-photo {
      border-radius: 0; overflow: hidden;
      aspect-ratio: 3/4;
      position: sticky; top: calc(var(--nav-h) + 24px);
    }
    .about-photo img { width: 100%; height: 100%; object-fit: cover; }
    .about-photo-placeholder {
      width: 100%; height: 100%;
      background: var(--surface2);
      display: flex; align-items: center; justify-content: center;
      font-size: 5rem;
    }
    .about-eyebrow {
      font-size: .65rem; font-weight: 500; letter-spacing: .25em;
      color: var(--text-dim); text-transform: uppercase; margin-bottom: 16px;
    }
    .about-name {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 200; line-height: 1.1;
      letter-spacing: -0.03em; margin-bottom: 20px;
    }
    .about-bio {
      color: var(--text-dim); line-height: 2;
      font-size: 1rem; font-weight: 300; margin-bottom: 32px;
      white-space: pre-line;
    }
    .trust-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
    .trust-item {
      display: flex; align-items: flex-start; gap: 12px;
      font-size: .92rem; color: var(--text-dim);
    }
    .trust-item::before {
      content: '✦';
      color: var(--accent); font-size: .7rem; flex-shrink: 0; margin-top: 4px;
    }
    .about-tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .about-tag {
      background: var(--surface2); border: 1px solid var(--border);
      padding: 6px 14px; border-radius: 0;
      font-size: .8rem; color: var(--text-dim);
    }
    .social-row { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
    .social-btn {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 20px; border-radius: 0;
      background: var(--surface2); border: 1px solid var(--border);
      font-size: .85rem; font-weight: 600;
      transition: border-color .2s, background .2s;
    }
    .social-btn:hover { border-color: var(--border2); background: var(--surface3); }
    @media(max-width:760px) {
      .about-grid { grid-template-columns: 1fr; gap: 36px; }
      .about-photo { position: static; aspect-ratio: 4/3; }
    }

    /* ── SERVICES ─────────────────────────────────────────────── */
    #services { padding: 100px 0; background: var(--surface); }
    .services-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .service-card {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 0;
      padding: 32px 24px;
      transition: border-color .25s;
    }
    .service-card:hover { border-color: var(--border2); }
    .service-icon { font-size: 2rem; margin-bottom: 16px; }
    .service-name { font-size: 1.05rem; font-weight: 600; margin-bottom: 8px; }
    .service-desc { font-size: .88rem; color: var(--text-dim); line-height: 1.7; font-weight: 300; }
    @media(max-width:760px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
    @media(max-width:480px) { .services-grid { grid-template-columns: 1fr; } }

    /* ── TESTIMONIALS ─────────────────────────────────────────── */
    #testimonials { padding: 100px 0; }
    .testimonials-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    .testimonial-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0;
      padding: 28px 24px;
      display: flex; flex-direction: column; gap: 16px;
    }
    .stars { color: var(--accent); font-size: .9rem; letter-spacing: 2px; }
    .testimonial-text {
      font-size: .95rem; color: var(--text-dim); line-height: 1.75;
      font-style: italic; font-weight: 300;
    }
    .testimonial-text::before { content: '"'; font-size: 1.3rem; color: var(--accent); }
    .testimonial-client { font-weight: 600; font-size: .9rem; letter-spacing: 0.04em; }
    @media(max-width:760px) { .testimonials-grid { grid-template-columns: 1fr; gap: 14px; } }

    /* ── CONTACT / LEAD FORM ──────────────────────────────────── */
    #contact {
      padding: 100px 0;
      background: var(--surface);
      border-top: 1px solid var(--border);
    }
    .contact-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 60px; align-items: center;
    }
    .contact-left h2 {
      font-size: clamp(1.7rem, 3.5vw, 2.4rem);
      font-weight: 300; letter-spacing: -0.02em; margin-bottom: 16px;
    }
    .contact-left p { color: var(--text-dim); line-height: 1.8; margin-bottom: 28px; font-weight: 300; }
    .contact-detail {
      display: flex; align-items: center; gap: 12px;
      font-size: .92rem; color: var(--text-dim); margin-bottom: 14px;
    }
    .contact-detail .icon { font-size: 1.1rem; }
    .contact-detail a { color: var(--accent); font-weight: 600; }
    .lead-form {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 0;
      padding: 36px 32px;
    }
    .form-title { font-size: 1.1rem; font-weight: 500; letter-spacing: 0.04em; margin-bottom: 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .78rem; color: var(--text-dim); margin-bottom: 6px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%; padding: 13px 16px;
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 0; color: var(--text);
      font-family: 'Outfit', sans-serif; font-size: .95rem;
      outline: none; transition: border-color .2s;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { border-color: var(--accent); }
    .form-group textarea { resize: vertical; min-height: 90px; }
    .form-group select option { background: var(--surface3); }
    ::placeholder { color: var(--text-dim); opacity: 1; }
    .btn-form {
      width: 100%; padding: 15px;
      background: var(--accent); color: #080806;
      border: none; border-radius: 0;
      font-family: 'Outfit', sans-serif;
      font-size: 0.88rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; cursor: pointer;
      transition: background .2s, transform .2s;
    }
    .btn-form:hover { background: var(--accent2); transform: translateY(-1px); }
    .form-success {
      display: none; text-align: center; padding: 20px;
      color: var(--accent); font-weight: 600; font-size: 1.05rem;
    }
    @media(max-width:760px) { .contact-grid { grid-template-columns: 1fr; gap: 40px; } }

    /* ── FOOTER ───────────────────────────────────────────────── */
    footer {
      background: #040402;
      border-top: 1px solid rgba(168,162,154,0.08);
      padding: 32px 20px;
      text-align: center;
      color: var(--text-dim); font-size: .8rem;
      letter-spacing: 0.05em;
    }
    footer a { color: var(--accent); }

    /* ── FLOATING WHATSAPP ────────────────────────────────────── */
    #wa-float {
      position: fixed; bottom: 24px; right: 20px; z-index: 700;
      width: 56px; height: 56px; border-radius: 50%;
      background: #25d366;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 20px rgba(37,211,102,.45);
      transition: transform .2s;
      font-size: 1.6rem;
    }
    #wa-float:hover { transform: scale(1.1); }

    /* ── POPUP ────────────────────────────────────────────────── */
    #popup-overlay {
      display: none; position: fixed; inset: 0; z-index: 9999;
      background: rgba(0,0,0,.82); backdrop-filter: blur(6px);
      align-items: center; justify-content: center; padding: 20px;
    }
    #popup-overlay.open { display: flex; }
    .popup-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0;
      max-width: 480px; width: 100%;
      overflow: hidden;
      animation: popIn .35s ease;
    }
    @keyframes popIn { from { opacity:0; transform:scale(.92); } to { opacity:1; transform:scale(1); } }
    .popup-img { width: 100%; max-height: 220px; object-fit: cover; }
    .popup-body { padding: 28px 24px; }
    .popup-title { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 10px; }
    .popup-text  { color: var(--text-dim); margin-bottom: 20px; line-height: 1.65; font-weight: 300; }
    .popup-btn {
      display: block; width: 100%;
      background: var(--accent); color: #080806;
      padding: 14px; border-radius: 0; border: none;
      font-family: 'Outfit', sans-serif;
      font-size: 0.88rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      cursor: pointer; text-align: center;
      transition: background .2s;
    }
    .popup-btn:hover { background: var(--accent2); }
    .popup-close {
      position: absolute; top: 16px; right: 16px;
      background: var(--surface2); border: none; color: var(--text);
      width: 36px; height: 36px; border-radius: 0;
      font-size: 1.1rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: background .2s;
    }
    .popup-close:hover { background: var(--surface3); }
    #popup-overlay { position: fixed; }
    .popup-wrap { position: relative; display: inline-block; width: 100%; max-width: 480px; }
  </style>
</head>
<body>

<!-- ── NAV ──────────────────────────────────────────────────────── -->
<nav id="nav">
  <div class="nav-inner">
    <div class="nav-logo">
      <% if (designer.logo && designer.logo.url) { %>
        <img src="<%= designer.logo.url %>" alt="<%= designer.name %>" />
      <% } %>
      <span class="nav-name"><%= designer.name %></span>
    </div>
    <div class="nav-links">
      <a href="#portfolio">Portfolio</a>
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </div>
    <a href="#contact" class="nav-cta">Free Consultation</a>
  </div>
</nav>

<!-- ── HERO ─────────────────────────────────────────────────────── -->
<section id="hero">
  <div class="hero-bg">
    <% if (designer.heroImage && designer.heroImage.url) { %>
      <img src="<%= designer.heroImage.url %>" alt="<%= designer.name %>" fetchpriority="high" />
    <% } %>
  </div>
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-content fade-up">
      <div class="hero-badge"><%= designer.badge || 'Interior Design Studio' %></div>
      <h1 class="hero-name"><%= designer.name %></h1>
      <p class="hero-tagline"><%= designer.tagline || 'Transforming spaces into extraordinary living experiences' %></p>
      <div class="hero-ctas">
        <a href="tel:<%= designer.phone %>" class="btn-primary" onclick="trackClick('call')">📞 Call Now</a>
        <a href="#contact" class="btn-secondary">Get a Free Quote ✦</a>
      </div>
    </div>
  </div>
</section>

<!-- ── STATS ─────────────────────────────────────────────────────── -->
<section id="stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item fade-up">
        <div class="stat-num"><%= designer.yearsExperience || 8 %>+</div>
        <div class="stat-label">Years of Experience</div>
      </div>
      <div class="stat-item fade-up" style="transition-delay:.1s">
        <div class="stat-num"><%= designer.projectsDone || 120 %>+</div>
        <div class="stat-label">Projects Completed</div>
      </div>
      <div class="stat-item fade-up" style="transition-delay:.2s">
        <div class="stat-num"><%= designer.portfolioImages ? designer.portfolioImages.length : 0 %>+</div>
        <div class="stat-label">Portfolio Works</div>
      </div>
      <div class="stat-item fade-up" style="transition-delay:.3s">
        <div class="stat-num"><%= designer.testimonials ? designer.testimonials.length : 0 %>+</div>
        <div class="stat-label">Client Reviews</div>
      </div>
    </div>
  </div>
</section>

<!-- ── PORTFOLIO ─────────────────────────────────────────────────── -->
<% if (designer.portfolioImages && designer.portfolioImages.length > 0) { %>
<section id="portfolio">
  <div class="container">
    <div class="section-header fade-up">
      <div class="section-eyebrow">Selected Work</div>
      <h2 class="section-title">Portfolio</h2>
      <p class="section-sub">Every project tells a unique story</p>
    </div>
    <div class="masonry" id="portfolio-grid">
      <% designer.portfolioImages.forEach(function(img, idx) { %>
      <div class="masonry-item fade-up" onclick="openLightbox(<%= idx %>)">
        <img src="<%= img.url %>" alt="Interior Design <%= idx + 1 %>" loading="lazy" />
        <div class="masonry-overlay"><span class="masonry-zoom">🔍</span></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ── LIGHTBOX ──────────────────────────────────────────────────── -->
<div id="lightbox">
  <button id="lb-close" onclick="closeLightbox()">✕</button>
  <button id="lb-prev" onclick="lbNav(-1)">‹</button>
  <img id="lb-img" src="" alt="" />
  <button id="lb-next" onclick="lbNav(1)">›</button>
</div>

<!-- ── ABOUT ─────────────────────────────────────────────────────── -->
<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-photo fade-up">
        <% if (designer.profileImage && designer.profileImage.url) { %>
          <img src="<%= designer.profileImage.url %>" alt="<%= designer.name %>" />
        <% } else { %>
          <div class="about-photo-placeholder">🎨</div>
        <% } %>
      </div>
      <div class="about-content fade-up" style="transition-delay:.15s">
        <div class="about-eyebrow">About Me</div>
        <h2 class="about-name"><%= designer.name %></h2>
        <% if (designer.businessName) { %><p style="color:var(--accent);font-weight:600;margin-bottom:16px;letter-spacing:0.04em"><%= designer.businessName %></p><% } %>
        <p class="about-bio"><%= designer.about || 'An interior designer with a passion for creating spaces that reflect the personality and lifestyle of each client. I believe every home has the potential to become a dream space — with the right vision and design approach.' %></p>

        <% if (designer.trustItems && designer.trustItems.length > 0) { %>
        <div class="trust-list">
          <% designer.trustItems.forEach(function(item) { %>
          <div class="trust-item"><%= item %></div>
          <% }); %>
        </div>
        <% } %>

        <% if (designer.specialties && designer.specialties.length > 0) { %>
        <div class="about-tags">
          <% designer.specialties.forEach(function(s) { %>
          <span class="about-tag"><%= s %></span>
          <% }); %>
        </div>
        <% } else if (designer.areas && designer.areas.length > 0) { %>
        <div class="about-tags">
          <% designer.areas.forEach(function(a) { %>
          <span class="about-tag">📍 <%= a %></span>
          <% }); %>
        </div>
        <% } %>

        <div class="social-row">
          <% if (designer.phone) { %>
          <a href="tel:<%= designer.phone %>" class="social-btn" onclick="trackClick('call')">📞 <span><%= designer.phone %></span></a>
          <% } %>
          <% if (designer.instagram) { %>
          <a href="https://instagram.com/<%= designer.instagram.replace('@','') %>" target="_blank" class="social-btn">📸 Instagram</a>
          <% } %>
          <% if (designer.facebook) { %>
          <a href="<%= designer.facebook %>" target="_blank" class="social-btn">👤 Facebook</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── SERVICES ───────────────────────────────────────────────────── -->
<% if (designer.services && designer.services.length > 0) { %>
<section id="services">
  <div class="container">
    <div class="section-header fade-up">
      <div class="section-eyebrow">What I Offer</div>
      <h2 class="section-title">Design Services</h2>
    </div>
    <div class="services-grid">
      <% designer.services.forEach(function(svc, i) {
        var parts = svc.split('|');
        var icon = parts[0] || '✦';
        var name = parts[1] || svc;
        var desc = parts[2] || '';
      %>
      <div class="service-card fade-up" style="transition-delay:<%= (i%3)*.1 %>s">
        <div class="service-icon"><%= icon %></div>
        <div class="service-name"><%= name %></div>
        <% if (desc) { %><div class="service-desc"><%= desc %></div><% } %>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ── TESTIMONIALS ───────────────────────────────────────────────── -->
<% if (designer.testimonials && designer.testimonials.length > 0) { %>
<section id="testimonials">
  <div class="container">
    <div class="section-header fade-up">
      <div class="section-eyebrow">Client Feedback</div>
      <h2 class="section-title">What Clients Say</h2>
    </div>
    <div class="testimonials-grid">
      <% designer.testimonials.forEach(function(t, i) { %>
      <div class="testimonial-card fade-up" style="transition-delay:<%= (i%3)*.1 %>s">
        <div class="stars"><%= '★'.repeat(t.rating || 5) %></div>
        <p class="testimonial-text"><%= t.text %></p>
        <div class="testimonial-client">— <%= t.clientName %></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- ── CONTACT / LEAD FORM ────────────────────────────────────────── -->
<section id="contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-left fade-up">
        <div class="section-eyebrow">Get in Touch</div>
        <h2>Let's talk about your space</h2>
        <p>Free initial consultation. I'd love to hear about your project and offer the perfect design solution.</p>
        <% if (designer.phone) { %>
        <div class="contact-detail"><span class="icon">📞</span><a href="tel:<%= designer.phone %>" onclick="trackClick('call')"><%= designer.phone %></a></div>
        <% } %>
        <% if (designer.whatsapp) { %>
        <div class="contact-detail"><span class="icon">💬</span><a href="https://wa.me/972<%= designer.whatsapp.replace(/[^0-9]/g,'').slice(-9) %>" onclick="trackClick('whatsapp')">WhatsApp</a></div>
        <% } %>
        <% if (designer.instagram) { %>
        <div class="contact-detail"><span class="icon">📸</span><a href="https://instagram.com/<%= designer.instagram.replace('@','') %>" target="_blank">@<%= designer.instagram.replace('@','') %></a></div>
        <% } %>
      </div>
      <div class="lead-form fade-up" style="transition-delay:.15s">
        <div class="form-title">Leave your details and we'll get back to you</div>
        <form id="lead-form">
          <div class="form-group">
            <label>Full Name *</label>
            <input type="text" id="f-name" required placeholder="Jane Smith" />
          </div>
          <div class="form-group">
            <label>Phone *</label>
            <input type="tel" id="f-phone" required placeholder="+1 555 000 0000" />
          </div>
          <div class="form-group">
            <label>Project Type</label>
            <select id="f-service">
              <option value="">Select project type</option>
              <% if (designer.services && designer.services.length > 0) {
                designer.services.forEach(function(svc) {
                  var name = svc.split('|')[1] || svc;
              %>
              <option value="<%= name %>"><%= name %></option>
              <% }); } %>
              <option value="Full Interior Design">Full Interior Design</option>
              <option value="Design Consultation">Design Consultation</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label>Message</label>
            <textarea id="f-msg" placeholder="Tell me about your space — size, location, what matters most to you..."></textarea>
          </div>
          <button type="submit" class="btn-form">Send Details ✦</button>
        </form>
        <div class="form-success" id="form-success">✅ Thank you! We'll be in touch shortly.</div>
      </div>
    </div>
  </div>
</section>

<!-- ── FOOTER ─────────────────────────────────────────────────────── -->
<footer>
  <p>© <%= new Date().getFullYear() %> <%= designer.name %> | Interior Design</p>
  <p style="margin-top:6px">Proudly built by <a href="https://tador.co.il" target="_blank">Tador</a></p>
</footer>

<!-- ── FLOATING WHATSAPP ─────────────────────────────────────────── -->
<a id="wa-float" href="https://wa.me/972<%= (designer.whatsapp||designer.phone||'').replace(/[^0-9]/g,'').slice(-9) %>"
   onclick="trackClick('whatsapp')" aria-label="WhatsApp">💬</a>

<!-- ── POPUP ─────────────────────────────────────────────────────── -->
<% if (designer.popup && designer.popup.active) { %>
<div id="popup-overlay">
  <div class="popup-wrap">
    <button class="popup-close" onclick="closePopup()">✕</button>
    <div class="popup-box">
      <% if (designer.popup.image && designer.popup.image.url) { %>
        <img class="popup-img" src="<%= designer.popup.image.url %>" alt="" />
      <% } %>
      <div class="popup-body">
        <div class="popup-title"><%= designer.popup.title || 'Want to transform your space?' %></div>
        <p class="popup-text"><%= designer.popup.text || 'Leave your details for a free initial consultation!' %></p>
        <a href="#contact" class="popup-btn" onclick="closePopup()"><%= designer.popup.btnText || 'Free Consultation' %></a>
      </div>
    </div>
  </div>
</div>
<% } %>

<script>
// ── Portfolio images data ──────────────────────────────────────────
const portfolioImages = <%- JSON.stringify(designer.portfolioImages || []) %>;
let lbIndex = 0;

function openLightbox(idx) {
  lbIndex = idx;
  document.getElementById('lb-img').src = portfolioImages[idx].url;
  document.getElementById('lightbox').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
  document.body.style.overflow = '';
}
function lbNav(dir) {
  lbIndex = (lbIndex + dir + portfolioImages.length) % portfolioImages.length;
  document.getElementById('lb-img').src = portfolioImages[lbIndex].url;
}
document.getElementById('lightbox').addEventListener('click', function(e) {
  if (e.target === this) closeLightbox();
});

// ── Scroll animations ─────────────────────────────────────────────
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
}, { threshold: 0.12 });
document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

// ── Nav scroll ────────────────────────────────────────────────────
window.addEventListener('scroll', () => {
  document.getElementById('nav').classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });

// ── Click tracking ────────────────────────────────────────────────
function trackClick(type) {
  fetch('/api/designer/click/<%= designer.slug %>', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ type })
  }).catch(() => {});
}

// ── Lead form ─────────────────────────────────────────────────────
document.getElementById('lead-form').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = this.querySelector('.btn-form');
  btn.disabled = true; btn.textContent = 'Sending...';
  try {
    const res = await fetch('/api/designer/lead/<%= designer.slug %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name:        document.getElementById('f-name').value,
        phone:       document.getElementById('f-phone').value,
        serviceType: document.getElementById('f-service').value,
        message:     document.getElementById('f-msg').value
      })
    });
    if (res.ok) {
      document.getElementById('lead-form').style.display = 'none';
      document.getElementById('form-success').style.display = 'block';
      trackClick('quote');
    }
  } catch(err) {}
  btn.disabled = false;
});

// ── Popup ─────────────────────────────────────────────────────────
<% if (designer.popup && designer.popup.active) { %>
setTimeout(() => {
  const seen = sessionStorage.getItem('popup_<%= designer.slug %>');
  if (!seen) {
    document.getElementById('popup-overlay').classList.add('open');
    sessionStorage.setItem('popup_<%= designer.slug %>', '1');
  }
}, <%= (designer.popup.delay || 3) * 1000 %>);
function closePopup() {
  document.getElementById('popup-overlay').classList.remove('open');
}
document.getElementById('popup-overlay').addEventListener('click', function(e) {
  if (e.target === this) closePopup();
});
<% } %>
</script>
</body>
</html>
